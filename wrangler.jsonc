{
  // Centrum voor Emotionele Basisbehoeften: site + editor op Cloudflare Workers.
  "name": "emotionelebasisbehoeften",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],
  "kv_namespaces": [{ "binding": "CONTENT", "id": "994c01f3b3874991bdf2c8e7406c8ba6" }],
  "vars": {
    // Wie mag inloggen op /admin (komma-gescheiden Google-accounts).
    "ADMIN_EMAILS": "jd.vanbrouwershaven@gmail.com,emotionelebasisbehoeften@gmail.com",
    // Client-ID uit Google Cloud Console (OAuth, type Webapplicatie). Niet geheim.
    // Project "Basisbehoeften website" onder jd.vanbrouwershaven@gmail.com.
    // MailerLite-groep waar nieuwe aanmeldingen in komen. Niet geheim. De API-sleutel staat als
    // geheim MAILERLITE_API_KEY in Cloudflare (Workers > Instellingen > Variabelen en geheimen).
    "MAILERLITE_GROUP_ID": "203104379596703455",
    "GOOGLE_CLIENT_ID": "542018349659-q5pioera0pmlsr23d7l0fkndm3vmj5dg.apps.googleusercontent.com"
  },
  "observability": { "enabled": true }
}
